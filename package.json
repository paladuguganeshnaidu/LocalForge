{
  "name": "localforge-vscode",
  "displayName": "LOMVREN",
  "description": "Use local Ollama and SSH-tunneled Ollama models for AI-assisted coding in VS Code.",
  "version": "1.0.0",
  "publisher": "paladuguganeshnaidu",
  "icon": "media/lomvren-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/paladuguganeshnaidu/LocalForge.git"
  },
  "homepage": "https://github.com/paladuguganeshnaidu/LocalForge#readme",
  "bugs": {
    "url": "https://github.com/paladuguganeshnaidu/LocalForge/issues"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "ollama",
    "local ai",
    "coding agent",
    "remote gpu",
    "ssh"
  ],
  "activationEvents": [
    "onView:localforge.chatView",
    "onView:localforge.modelsView",
    "onCommand:localforge.openAgent",
    "onCommand:localforge.newConversation",
    "onCommand:localforge.continueTask",
    "onCommand:localforge.reviewChanges",
    "onCommand:localforge.undoChanges",
    "onCommand:localforge.showArtifacts",
    "onCommand:localforge.diagnose",
    "onCommand:localforge.doctor",
    "onCommand:localforge.selfTest",
    "onCommand:localforge.refreshModels",
    "onCommand:localforge.connectRemote",
    "onCommand:localforge.disconnectRemote",
    "onCommand:localforge.remoteGpuStatus",
    "onCommand:localforge.reindexWorkspace",
    "onCommand:localforge.cancelAgent",
    "onCommand:localforge.setAgentMode",
    "onCommand:localforge.setModel",
    "onStartupFinished"
  ],
  "main": "./dist/extension.bundle.js",
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "localforge-secondary",
          "title": "lomvren",
          "icon": "media/localforge.svg"
        }
      ]
    },
    "views": {
      "localforge-secondary": [
        {
          "type": "webview",
          "id": "localforge.chatView",
          "name": "LOMVREN Agent"
        },
        {
          "type": "webview",
          "id": "localforge.modelsView",
          "name": "Models"
        }
      ]
    },
    "commands": [
      {
        "command": "localforge.openAgent",
        "title": "LOMVREN: Open Agent"
      },
      {
        "command": "localforge.newConversation",
        "title": "LOMVREN: New Conversation"
      },
      {
        "command": "localforge.continueTask",
        "title": "LOMVREN: Continue Previous Task"
      },
      {
        "command": "localforge.reviewChanges",
        "title": "LOMVREN: Review Changes"
      },
      {
        "command": "localforge.showArtifacts",
        "title": "LOMVREN: Show Artifacts"
      },
      {
        "command": "localforge.diagnose",
        "title": "LOMVREN: Diagnose Installation"
      },
      {
        "command": "localforge.doctor",
        "title": "LOMVREN: Doctor"
      },
      {
        "command": "localforge.selfTest",
        "title": "LOMVREN: Run Self-Test"
      },
      {
        "command": "localforge.refreshModels",
        "title": "LOMVREN: Refresh Models"
      },
      {
        "command": "localforge.connectRemote",
        "title": "LOMVREN: Connect to Remote GPU Host"
      },
      {
        "command": "localforge.disconnectRemote",
        "title": "LOMVREN: Disconnect Remote GPU Host"
      },
      {
        "command": "localforge.remoteGpuStatus",
        "title": "LOMVREN: Show Remote GPU Status"
      },
      {
        "command": "localforge.reindexWorkspace",
        "title": "LOMVREN: Re-index Workspace Context"
      },
      {
        "command": "localforge.cancelAgent",
        "title": "LOMVREN: Cancel Agent"
      },
      {
        "command": "localforge.setAgentMode",
        "title": "LOMVREN: Set Agent Mode"
      },
      {
        "command": "localforge.setModel",
        "title": "LOMVREN: Set Model"
      },
      {
        "command": "localforge.editSelection",
        "title": "LOMVREN: Propose a Diff-Reviewed Edit"
      },
      {
        "command": "localforge.undoChanges",
        "title": "LOMVREN: Undo Recorded Changes"
      },
      {
        "command": "localforge.explain",
        "title": "LOMVREN: Explain Selected Code"
      },
      {
        "command": "localforge.fix",
        "title": "LOMVREN: Fix Selected Code or Diagnostics"
      },
      {
        "command": "localforge.searchWorkspace",
        "title": "LOMVREN: Search Workspace Context"
      },
      {
        "command": "localforge.configureRemote",
        "title": "LOMVREN: Configure Remote GPU Host"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "localforge.explain",
          "group": "LOMVREN@1",
          "when": "editorHasSelection"
        },
        {
          "command": "localforge.fix",
          "group": "LOMVREN@2",
          "when": "editorTextFocus"
        },
        {
          "command": "localforge.editSelection",
          "group": "LOMVREN@3",
          "when": "editorTextFocus"
        }
      ]
    },
    "configuration": {
      "title": "LOMVREN",
      "properties": {
        "localforge.chatMemory.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Retrieve relevant older user/assistant messages locally using lexical BM25 ranking. Raw tool results are excluded."
        },
        "localforge.chatMemory.scope": {
          "type": "string",
          "enum": [
            "current",
            "all"
          ],
          "default": "current",
          "scope": "resource",
          "description": "Current chat is private by default. All explicitly allows retrieval from other chats in this workspace. Retrieved evidence may be sent to the selected model endpoint."
        },
        "localforge.chatMemory.recentCharacters": {
          "type": "integer",
          "default": 6000,
          "minimum": 0,
          "maximum": 32000,
          "scope": "resource",
          "description": "Character budget for up to ten recent user/assistant messages, separate from older-chat retrieval."
        },
        "localforge.chatMemory.retrievedCharacters": {
          "type": "integer",
          "default": 3000,
          "minimum": 0,
          "maximum": 16000,
          "scope": "resource",
          "description": "Maximum older-chat excerpt characters. Model input budget can reduce this further."
        },
        "localforge.chatMemory.resultCount": {
          "type": "integer",
          "default": 4,
          "minimum": 1,
          "maximum": 20,
          "scope": "resource",
          "description": "Maximum retrieved older-chat messages. Use /search chat <query> and /context to inspect sources."
        },
        "localforge.agent.maxRounds": {
          "type": "integer",
          "default": 80,
          "minimum": 0,
          "maximum": 10000,
          "description": "Maximum model/tool rounds per task. 0 continues until completion or cancellation, with repeated-action protection. Local model context and memory are still finite."
        },
        "localforge.agent.contextTokens": {
          "type": "integer",
          "default": 4000,
          "minimum": 500,
          "maximum": 100000,
          "description": "Estimated token budget for automatically retrieved project context. Increase only when your model and hardware support it."
        },
        "localforge.agent.historyCharacters": {
          "type": "integer",
          "default": 48000,
          "minimum": 16000,
          "maximum": 1000000,
          "description": "Conversation character budget before old tool results are compacted. This is not an exact model token or context-window measurement."
        },
        "localforge.context.maxIndexedFiles": {
          "type": "integer",
          "default": 2000,
          "minimum": 1,
          "maximum": 20000,
          "scope": "resource",
          "description": "Maximum eligible text files retained in the local workspace index. The index status reports partial coverage when a file, character, or discovery limit is reached."
        },
        "localforge.context.maxFileBytes": {
          "type": "integer",
          "default": 262144,
          "minimum": 1024,
          "maximum": 8388608,
          "scope": "resource",
          "description": "Maximum bytes per indexed text file. Binary/generated/ignored/sensitive files remain excluded."
        },
        "localforge.context.maxIndexCharacters": {
          "type": "integer",
          "default": 8000000,
          "minimum": 100000,
          "maximum": 64000000,
          "scope": "resource",
          "description": "Total retained source-text character limit for local workspace retrieval. Higher limits use more memory; chunk strings and metadata also consume memory."
        },
        "localforge.ollama.contextWindow": {
          "type": "integer",
          "default": 8192,
          "minimum": 2048,
          "maximum": 1048576,
          "description": "Ollama num_ctx for local chat. Larger context needs more RAM/VRAM and must be supported by the selected model."
        },
        "localforge.ollama.maxOutputTokens": {
          "type": "integer",
          "default": -1,
          "minimum": -1,
          "maximum": 1048576,
          "description": "Ollama num_predict. -1 leaves generation uncapped by this extension; finite model context and hardware still apply. Cancel stops generation."
        },
        "localforge.ollama.baseUrl": {
          "type": "string",
          "scope": "machine",
          "default": "http://127.0.0.1:11434",
          "description": "Base URL for the local Ollama server."
        },
        "localforge.ollama.temperature": {
          "type": "number",
          "default": 0.1,
          "minimum": 0,
          "maximum": 2,
          "description": "Local generation sampling temperature. A low value makes coding/tool use less variable; model accuracy is not guaranteed."
        },
        "localforge.ollama.agentThinking": {
          "type": "boolean",
          "default": false,
          "description": "Request internal reasoning from thinking-capable models. Off requests non-thinking mode only when the runtime advertises that control; thinking-only models may still reason. For faster CPU tool execution, select a non-thinking Instruct model. Reasoning is not displayed as chat."
        },
        "localforge.providers.openAICompatibleUrls": {
          "type": "string",
          "scope": "machine",
          "default": "http://127.0.0.1:1234/v1,http://127.0.0.1:8080/v1,http://127.0.0.1:8000/v1",
          "description": "Comma- or newline-separated HTTP(S) API base URLs. Each endpoint has independent discovery/routing. No credentials, query parameters or fragments. Remote endpoints receive selected model prompts/context. Applies after an active task finishes."
        },
        "localforge.autocomplete.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable local-model inline code completions. Prompts include nearby editor text."
        },
        "localforge.routing.chatModel": {
          "type": "string",
          "default": "",
          "description": "Preferred model id or provider id for chat. Leave blank to use the selected model."
        },
        "localforge.routing.editModel": {
          "type": "string",
          "default": "",
          "description": "Preferred model id or provider id for edit proposals."
        },
        "localforge.routing.agentModel": {
          "type": "string",
          "default": "",
          "description": "Preferred model id or provider id for agent tasks."
        },
        "localforge.routing.completionModel": {
          "type": "string",
          "default": "",
          "description": "Preferred model id or provider id for inline completions."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run compile && npm run bundle",
    "bundle": "esbuild dist/extension.js --bundle --platform=node --format=cjs --target=node20 --external:vscode --external:cpu-features --external:playwright-core --external:*.node --outfile=dist/extension.bundle.js",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test tests/*.test.js",
    "test:extension-host": "npm run build && node tests/runExtensionHostTests.js",
    "test:recovery-restart": "npm run build && node tests/runRecoveryRestartTests.js",
    "test:chat-restart": "npm run build && node tests/runChatRestartTests.js",
    "test:ollama-smoke": "node scripts/smoke-ollama.cjs",
    "test:ollama-agent": "npm run compile && node scripts/smoke-ollama-agent.cjs",
    "test:ollama-summary": "npm run compile && node scripts/smoke-project-summary.cjs",
    "test:ollama-greeting": "npm run build && node tests/runChatRestartTests.js --live-greeting",
    "test:chat-memory": "npm run build && node tests/runChatRestartTests.js --chat-memory",
    "test:ollama-memory": "npm run build && node tests/runChatRestartTests.js --live-memory",
    "package": "node scripts/package-extension.cjs",
    "release": "node scripts/release.cjs"
  },
  "dependencies": {
    "ignore": "7.0.10",
    "minimatch": "10.2.6",
    "playwright-core": "1.63.0",
    "undici": "7.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/ssh2": "^1.15.5",
    "@types/vscode": "^1.106.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.28.2",
    "ssh2": "^1.17.0",
    "typescript": "^5.8.3"
  }
}
